{
  "compilerOptions": {
    "target": "ES2020",
    "module": "CommonJS",
    "rootDir": "./src",
    "outDir": "./dist",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true, // avoids case-sensitive issues
    "resolveJsonModule": true                // if you import .json anywhere
  },
  "include": ["src"]
}